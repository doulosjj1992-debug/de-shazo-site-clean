{
  "rewrites": [
    { "source": "/",           "destination": "/mirror/index.html" },
    { "source": "/index.html", "destination": "/mirror/index.html" },

    { "source": "/:slug",      "destination": "/mirror/:slug.html" },
    { "source": "/:path*",     "destination": "/mirror/:path*" }
  ],
  "redirects": [
    { "source": "/projects/mixed-use-facilties", "destination": "/projects/mixed-use-facilities", "permanent": true }
  ]
}
