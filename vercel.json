{
  "buildCommand": "echo 'Static files ready'",
  "outputDirectory": "public",
  "framework": null,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/_next/(.*)", "destination": "https://www.deshazogroup.com/_next/$1" },
    { "source": "/uploads/(.*)", "destination": "https://www.deshazogroup.com/uploads/$1" },
    { "source": "/favicon.ico", "destination": "https://www.deshazogroup.com/favicon.ico" },

    { "source": "^/$", "destination": "/mirror/index.html" },

    { "source": "^/(.*)/$", "destination": "/mirror/$1/index.html" },
    { "source": "^/(.*)$",  "destination": "/mirror/$1.html" }
  ]
}
